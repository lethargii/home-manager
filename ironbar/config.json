{
	"hot_reload": true,
  "start": [
		{
      "type": "custom",
      "name": "power-menu",
      "class": "power-menu",
      "bar": [
        {
          "type": "button",
          "name": "power-btn",
          "label": "",
          "on_click": "popup:toggle"
        }
      ],
      "popup": [
        {
          "type": "box",
          "orientation": "vertical",
          "widgets": [
            {
              "type": "label",
              "name": "header",
              "label": "Power menu"
            },
            {
              "type": "box",
              "name": "buttons",
              "widgets": [
                {
                  "type": "button",
                  "class": "power-btn",
                  "label": "<span>󰐥</span>",
                  "on_click": "!shutdown now"
                },
                {
                  "type": "button",
                  "class": "power-btn",
                  "label": "<span>󰜉</span>",
                  "on_click": "!reboot"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "menu",
      "label": "󱓞"
    },
    {
      "type": "workspaces"
    },
    {
      "type": "launcher",
      "favorites": [
        "firefox"
      ],
			"icon_size": 24,
      "truncate": {
        "mode": "end",
        "max_length": 30
      }
    }
  ],
  "center": [
    {
      "type": "music",
			"truncate": {
				"mode": "end",
				"max_length": 20
			},
			"truncate_popup_artist": {
				"mode": "end",
				"max_length": 20
			},
			"truncate_popup_album": {
				"mode": "end",
				"max_length": 20
			},
			"truncate_popup_title": {
				"mode": "end",
				"max_length": 20
			}
    },
		{
      "type": "focused",
      "show_icon": true,
      "show_title": true,
      "icon_size": 16,
      "truncate": {
				"mode": "end",
				"max_length": 10
			}
    }
  ],
  "end": [
    {
      "type": "clipboard",
      "max_items": 5,
      "truncate": {
        "mode": "end",
        "length": 30
      }
    },
    {
      "type": "battery",
      "show_if": "ls /sys/class/power_supply/ | grep --quiet '^BAT'",
			"icon_size": 16
    },
    {
      "type": "volume"
    },
		{
      "type": "brightness",
      "smooth_scroll_speed": 0.5
    },
    {
      "type": "bluetooth"
    },
    {
      "type": "tray"
    },
    {
      "type": "notifications",
			"show_count": false
    },
    {
      "type": "clock"
    }
  ]
}
